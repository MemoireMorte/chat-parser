# Twitch OAuth application credentials
# Create an app at https://dev.twitch.tv/console/apps
PUBLIC_TWITCH_CLIENT_ID=your_twitch_client_id

# Must match a Redirect URL registered in the Twitch app
# dev: http://localhost:5173 — docker: http://<server-ip>:3000
PUBLIC_TWITCH_REDIRECT_URI=http://localhost:5173

# URL you open the app with (production / docker only)
ORIGIN=http://localhost:3000

# Discord webhook URL for posting detected chat URLs (optional — keep secret)
# Create one in your Discord server: Channel Settings > Integrations > Webhooks
DISCORD_WEBHOOK_URL=
